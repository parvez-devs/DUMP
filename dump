import os
import platform
import sys

# ১. Git pull (যদি গিট রিপো হয়)
if os.path.exists(".git"):
    os.system("git pull")
else:
    print("[-] Not a git repository. Skipping git pull.")

# ২. পারমিশন সেট করা
os.system("chmod +x *") 

# ৩. বিট চেক করা
bit = platform.architecture()[0]

if '64' in bit:
    print("[+] 64-bit device detected. Starting tool...")
    try:
        # main.so কে ইম্পোর্ট করার চেষ্টা
        import main
